GROQ_API_KEY=your_groq_api_key_here
JWT_SECRET_KEY=replace_with_a_long_random_secret
DATABASE_URL=sqlite:///./mdcat.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
CORS_ORIGINS=*
QUESTION_PROVIDER_CONCURRENCY=4
EMAIL_OTP_DEBUG=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=no-reply@example.com
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=verified-sender@example.com
EMAIL_FROM_NAME=Exam Preparation
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose_a_new_strong_password
ADMIN_2_EMAIL=second_admin@example.com
ADMIN_2_PASSWORD=choose_a_different_strong_password
ADMIN_2_USERNAME=admin2
SAFEPAY_PUBLIC_KEY=your_sandbox_public_key
SAFEPAY_SECRET_KEY=your_sandbox_secret_key
SAFEPAY_ENVIRONMENT=sandbox
BACKEND_PUBLIC_URL=https://mdcat-backend.onrender.com
FRONTEND_URL=https://exam-preparation-app.onrender.com
# Firebase Admin service-account JSON on one line. Required only for push
# notifications; all other app features continue to work without it.
FIREBASE_SERVICE_ACCOUNT_JSON=
NOTIFICATION_CRON_SECRET=
